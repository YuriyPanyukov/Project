<mxfile host="app.diagrams.net" modified="2026-11-17T00:00:00.000Z" agent="drawio" version="24.0.0">
  <diagram name="Диаграмма состояний" id="state-machine">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="UML. Диаграмма состояний (State Machine Diagram)&#10;Объект программы: Фильм в коллекции : Movie (статусы из таблицы statuses)" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="800" height="50" as="geometry" />
        </mxCell>

        <!-- Начальное состояние -->
        <mxCell id="start" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="80" y="140" width="24" height="24" as="geometry" />
        </mxCell>

        <!-- Состояние: Создан -->
        <mxCell id="sCreated" value="Создан&#10;(«В планах», status_id=1)&#10;entry / валидация данных,&#10;insert() в movies.db" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="160" y="100" width="200" height="100" as="geometry" />
        </mxCell>

        <!-- Состояние: Редактируется -->
        <mxCell id="sEdit" value="Редактируется&#10;do / edit_movie():&#10;изменение названия, длительности, оценки" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="100" width="220" height="100" as="geometry" />
        </mxCell>

        <!-- Superstate: Просмотр (с подобластями) -->
        <mxCell id="sWatch" value="Просмотр [superstate]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;verticalAlign=top;fontStyle=1;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="160" y="280" width="530" height="300" as="geometry" />
        </mxCell>
        <mxCell id="subStart" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="185" y="320" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="sInProcess" value="Смотрится&#10;(«В процессе», status_id=2)&#10;entry / change_status(2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="230" y="310" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="sFinished" value="Просмотрен&#10;(«Завершено», status_id=3)&#10;entry / проставление оценки rating" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="310" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="sDropped" value="Брошен&#10;(«Брошено», status_id=4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="230" y="460" width="190" height="80" as="geometry" />
        </mxCell>

        <!-- Состояние: Удаляется -->
        <mxCell id="sDelete" value="Удаляется&#10;entry / подтверждение удаления,&#10;delete(movie_id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="300" width="200" height="90" as="geometry" />
        </mxCell>

        <!-- Состояние: Ошибка -->
        <mxCell id="sError" value="Ошибка валидации&#10;[BusinessRuleError / NotFoundError]&#10;do / вывод сообщения об ошибке" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="100" width="230" height="90" as="geometry" />
        </mxCell>

        <!-- Завершающее состояние -->
        <mxCell id="finishOuter" value="" style="shape=doubleCircle;html=1;fillColor=none;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
