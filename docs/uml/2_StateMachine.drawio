          <mxGeometry x="1089" y="449" width="18" height="18" as="geometry" />
        </mxCell>

        <!-- Переходы -->
        <mxCell id="t1" style="endArrow=block;endFill=1;html=1;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="start" target="sCreated">
          <mxGeometry relative="1" as="geometry" />
