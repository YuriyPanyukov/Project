@startuml 02_state_machine
!theme plain
skinparam defaultFontName "DejaVu Sans"
skinparam dpi 150
skinparam shadowing false
title Диаграмма состояний программы\n«Менеджер личной коллекции фильмов» (State Machine Diagram)

[*] -> Инициализация

state Инициализация {
    [*] -> Открытие_БД
    Открытие_БД : действие: database.get_connection()
    Открытие_БД -> Проверка_схемы
    Проверка_схемы : действие: выполнение init.sql,\nсоздание таблиц и справочников
    Проверка_схемы -> Загрузка_коллекции : MovieDAO.getAll()
    Загрузка_коллекции : действие: чтение списка фильмов
    Загрузка_коллекции -> [*]
}

state "Главное меню\n(рабочее состояние)" as ГлавноеМеню #LightBlue {
    [*] -> Ожидание_команды
    Ожидание_команды : действие: вывод меню:\n[Добавить / Список / Изменить /\nУдалить / Поиск / Статус / Аналитика / Выход]
    Ожидание_команды -> Ожидание_команды : ввод некорректной команды /\nповторный запрос ввода
}

state "Добавление фильма" as Добавление {
    [*] -> Ввод_данных
    Ввод_данных : действие: форма ввода\n(title, duration, rating, status_id,\nжанры, персоны)
    Ввод_данных -> Валидация
    Валидация : действие: MovieService._validate_movie_data(),\n_ensure_status_exists(), _validate_links()
    state Ошибка_валидации <<error>>
    Валидация --> Ошибка_валидации : [нарушение бизнес-правил]\nBusinessRuleError
    Ошибка_валидации : действие: вывод текста ошибки
    Ошибка_валидации --> Ввод_данных : повторный ввод
    Валидация -> Сохранение : [данные корректны]
    Сохранение : действие: транзакция:\nMovieDAO.insert() +\nStatsDAO.replace_movie_links()
    Сохранение -> [*] : фильм добавлен,\nобновление списка
}

state "Просмотр и поиск" as Просмотр {
    [*] -> Выбор_режима
    Выбор_режима : действие: список всей коллекции\nили фильтрация/поиск
    Выбор_режима -> Формирование_запроса : критерии поиска
    Формирование_запроса : действие: MovieService.search_movies()\n(query, жанр, статус, диапазон оценок,\nсортировка)
    Формирование_запроса -> Отображение_результатов
    Отображение_результатов : действие: MovieDAO.search_movies(),\nвывод таблицы фильмов
    Отображение_результатов -> Отображение_результатов : изменить фильтры /\nсортировку
    Отображение_результатов -> [*]
}

state "Редактирование фильма" as Редактирование {
    [*] -> Выбор_фильма
    Выбор_фильма : действие: MovieDAO.getById(id)
    Выбор_фильма -> Изменение_полей
    Изменение_полей : действие: изменение title, duration,\nrating, status_id, жанров, персон
    Изменение_полей -> Сохранение_изменений
    Сохранение_изменений : действие: MovieService.edit_movie():\nвалидация + MovieDAO.update()
    Сохранение_изменений -> [*] : изменения записаны в БД
}

state "Изменение статуса просмотра" as Статусы {
    state "В планах" as SPlan
    state "В процессе" as SProc
    state "Завершено" as SDone
    [*] -> SPlan : новый фильм (status_id = 1)
    SPlan --> SProc : [change_status] начат просмотр
    SProc --> SDone : [change_status] просмотр завершён
    SProc --> SPlan : [change_status] отложен
    SDone --> SProc : [change_status] пересматривается
}

state "Удаление фильма" as Удаление {
    [*] -> Подтверждение
    Подтверждение : действие: delete_movie(id, confirmed)
    Подтверждение --> Отмена : [confirmed = False]\n«Удаление отменено»
    Отмена : действие: фильм сохранён
    Отмена --> [*]
    Подтверждение -> Исполнение : [confirmed = True]
    Исполнение : действие: MovieDAO.delete(id),\nкаскадное удаление связей
    Исполнение -> [*]
}

state "Аналитика коллекции" as Аналитика {
    [*] -> Расчёт_метрик
    Расчёт_метрик : действие: StatsDAO:\ngetCollectionSummaryStats(),\ngetTopMoviePersonsByRole(),\ngetMoviesDistributionByStatus(),\ngetTopGenresReport()
    Расчёт_метрик -> Вывод_отчёта : визуализация статистики
    Вывод_отчёта -> [*]
}

state "Ошибки выполнения" as Errors #LightYellow {
    state NotFoundError
    state BusinessRuleError
    NotFoundError : запись с указанным ID не найдена
    BusinessRuleError : нарушение бизнес-правил / ошибка БД
}

'---------- переходы главного уровня (программа целиком) ----------
Инициализация -> ГлавноеМеню : БД готова к работе

ГлавноеМеню -> Добавление : команда «Добавить фильм»
ГлавноеМеню -> Просмотр : команда «Список / Поиск»
ГлавноеМеню -> Редактирование : команда «Изменить фильм»
ГлавноеМеню -> Статусы : команда «Изменить статус»
ГлавноеМеню -> Удаление : команда «Удалить фильм»
ГлавноеМеню -> Аналитика : команда «Аналитика»

Добавление -> ГлавноеМеню : успех / ошибка валидации
Просмотр -> ГлавноеМеню : возврат в меню
Редактирование -> ГлавноеМеню : успех / запись не найдена
Статусы -> ГлавноеМеню : статус обновлён
Удаление -> ГлавноеМеню : удалено / отменено
Аналитика -> ГлавноеМеню : отчёт сформирован

Добавление -right-> Errors : исключение
Редактирование -right-> Errors : исключение
Удаление -right-> Errors : исключение
Просмотр -right-> Errors : исключение
Errors -> ГлавноеМеню : обработка ошибки,\nвывод сообщения

ГлавноеМеню -> Завершение : команда «Выход»
state Завершение {
    [*] -> Закрытие_БД
    Закрытие_БД : действие: закрытие соединений sqlite3,\nсохранение movies.db
    Закрытие_БД -> [*]
}
Завершение -> [*]

@enduml
