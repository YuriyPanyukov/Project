flowchart TD
    A([Начало]) --> B[/Получить данные фильма/]
    B --> C{Название заполнено?}
    C -- Нет --> E[Сообщение об ошибке]
    C -- Да --> F{Продолжительность больше 0?}
    F -- Нет --> E
    F -- Да --> G{Оценка от 0 до 10 или не задана?}
    G -- Нет --> E
    G -- Да --> H{Статус, жанры и персоны существуют?}
    H -- Нет --> E
    H -- Да --> I[Начать транзакцию]
    I --> J[Добавить фильм через DAO]
    J --> K[Добавить связи с жанрами]
    K --> L[Добавить связи с персонами]
    L --> M{Все операции успешны?}
    M -- Да --> N[COMMIT]
    N --> O[Сообщить об успешном добавлении]
    M -- Нет --> P[ROLLBACK]
    P --> Q[Записать ошибку в журнал]
    Q --> R[Сообщить о сбое]
    E --> S([Конец])
    O --> S
    R --> S
