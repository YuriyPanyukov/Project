flowchart TD
    A([Начало]) --> B[/Получить параметры отчёта/]
    B --> C{Размер рейтинга от 1 до 20?}
    C -- Нет --> D[Сообщить об ошибке параметров]
    C -- Да --> E[Получить количество фильмов и среднюю оценку]
    E --> F[Получить распределение по статусам]
    F --> G[Получить топ жанров]
    G --> H[Получить топ персон по роли]
    H --> I{Все запросы успешны?}
    I -- Нет --> J[Записать ошибку в журнал]
    J --> K[Сообщить о сбое формирования отчёта]
    I -- Да --> L[Объединить результаты]
    L --> M{Коллекция пуста?}
    M -- Да --> N[Показать 0 фильмов и отсутствие средней оценки]
    M -- Нет --> O[Показать полную статистику]
    N --> P([Конец])
    O --> P
    D --> P
    K --> P
